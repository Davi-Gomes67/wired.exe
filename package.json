{
  "name": "wired-exe",
  "version": "1.0.0",
  "private": true,
  "description": "WIRED.exe - marketplace de eletronicos, hardware e cultura geek",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node backend/src/server.js",
    "dev:web": "npm --prefix frontend run dev",
    "start": "node backend/src/server.js",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "node --test backend/tests/*.test.js",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma --name init",
    "db:migrate:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "prisma db seed --schema backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema backend/prisma/schema.prisma",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma"
  },
  "prisma": {
    "seed": "node backend/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
